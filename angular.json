{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"MFEShell": {
			"projectType": "application",
			"schematics": {},
			"root": "projects/mfeshell",
			"sourceRoot": "projects/mfeshell/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {},
					"configurations": {
						"production": {
							"target": "MFEShell:esbuild:production"
						},
						"development": {
							"target": "MFEShell:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "MFEShell:serve-original:development",
						"rebuildDelay": 0,
						"dev": true,
						"port": 0
					}
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/mfeshell/tsconfig.spec.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/mfeshell/public"
							}
						],
						"styles": [
							"projects/mfeshell/src/styles.css"
						],
						"scripts": []
					}
				},
				"esbuild": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"outputPath": "dist/mfeshell",
						"index": "projects/mfeshell/src/index.html",
						"browser": "projects/mfeshell/src/main.ts",
						"polyfills": [
							"zone.js",
							"es-module-shims"
						],
						"tsConfig": "projects/mfeshell/tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/mfeshell/public"
							}
						],
						"styles": [
							"projects/mfeshell/src/styles.css"
						],
						"scripts": []
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "2kB",
									"maximumError": "4kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-original": {
					"builder": "@angular-devkit/build-angular:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "MFEShell:esbuild:production"
						},
						"development": {
							"buildTarget": "MFEShell:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200
					}
				}
			}
		},
		"MFEBuscaCep": {
			"projectType": "application",
			"schematics": {},
			"root": "projects/mfebusca-cep",
			"sourceRoot": "projects/mfebusca-cep/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {},
					"configurations": {
						"production": {
							"target": "MFEBuscaCep:esbuild:production"
						},
						"development": {
							"target": "MFEBuscaCep:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "MFEBuscaCep:serve-original:development",
						"rebuildDelay": 0,
						"dev": true,
						"port": 0
					}
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/mfebusca-cep/tsconfig.spec.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/mfebusca-cep/public"
							}
						],
						"styles": [
							"projects/mfebusca-cep/src/styles.css"
						],
						"scripts": []
					}
				},
				"esbuild": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"outputPath": "dist/mfebusca-cep",
						"index": "projects/mfebusca-cep/src/index.html",
						"browser": "projects/mfebusca-cep/src/main.ts",
						"polyfills": [
							"zone.js",
							"es-module-shims"
						],
						"tsConfig": "projects/mfebusca-cep/tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/mfebusca-cep/public"
							}
						],
						"styles": [
							"projects/mfebusca-cep/src/styles.css"
						],
						"scripts": []
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "2kB",
									"maximumError": "4kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-original": {
					"builder": "@angular-devkit/build-angular:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "MFEBuscaCep:esbuild:production"
						},
						"development": {
							"buildTarget": "MFEBuscaCep:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4201
					}
				}
			}
		}
	}
}